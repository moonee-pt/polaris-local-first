# Optional selfhost/API origin for local dev proxy and native internal API routes.
# Leave empty for same-origin web development. Set this to your own selfhost or relay origin.
# Example: https://polaris-example.vercel.app
VITE_POLARIS_API_ORIGIN=

# Optional desktop host API origin for desktop package builds.
# The polaris://app file origin is an app shell, not an API origin.
POLARIS_DESKTOP_API_ORIGIN=

# MongoDB cloud sync backend (used by /api/sync/* Vercel functions).
# Paste your MongoDB Atlas connection string. Keep the real value in .env / Vercel env, never commit it.
MONGODB_URI=
# Database name to store snapshots in (defaults to "polaris").
MONGODB_DB=polaris

# Extra comma-separated CORS origins allowed to call /api/sync (e.g. your custom domain).
# Example: https://qoder.zone,https://polaris-example.vercel.app
POLARIS_API_EXTRA_ORIGINS=

# Cloud-sync encryption key + access token. The server derives an AES-256-GCM key from this
# value to encrypt snapshots at rest, and requires it as the X-Polaris-Sync-Token header.
# Generate any long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# The SAME value must be set in local .env and in Vercel (as VITE_POLARIS_SYNC_SECRET and SYNC_SECRET). Keep it secret, never commit.
VITE_POLARIS_SYNC_SECRET=
